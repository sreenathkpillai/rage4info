# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/care-resource-hub

# JWT Configuration
JWT_SECRET=your-very-secure-jwt-secret-key-here

# Admin Login (REQUIRED for production - without these the server falls back
# to the default credentials and logs a warning)
ADMIN_EMAIL=admin@rage4info.org
# Either a plain password (hashed at startup)...
ADMIN_PASSWORD=choose-a-strong-password
# ...or a pre-computed bcrypt hash (takes precedence over ADMIN_PASSWORD)
# ADMIN_PASSWORD_HASH=$2a$10$...

# Client Configuration
CLIENT_URL=http://localhost:5173

# Optional: for production deployment
# DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/care-resource-hub
# REDIS_URL=redis://localhost:6379